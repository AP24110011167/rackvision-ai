{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rackvision-backend.onrender.com/api/:path*"
    },
    {
      "source": "/outputs/:path*",
      "destination": "https://rackvision-backend.onrender.com/outputs/:path*"
    }
  ]
}
